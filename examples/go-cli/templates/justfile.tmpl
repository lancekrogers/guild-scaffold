# {{ .vars.project_name }} - justfile

# Default recipe shows help
default:
    @just --list

# Build the CLI binary
build:
    go build -o bin/{{ .vars.project_name }} ./cmd/{{ .vars.project_name }}

# Run the CLI
run *ARGS:
    go run ./cmd/{{ .vars.project_name }} {{ "{{ARGS}}" }}

# Run tests
test:
    go test ./...

# Run tests with coverage
test-coverage:
    go test -coverprofile=coverage.out ./...
    go tool cover -html=coverage.out -o coverage.html

# Format code
fmt:
    go fmt ./...

# Run linter
lint:
    golangci-lint run

# Clean build artifacts
clean:
    rm -rf bin/
    rm -f coverage.out coverage.html

# Install dependencies
deps:
    go mod download
    go mod tidy

# Install the CLI locally
install: build
    cp bin/{{ .vars.project_name }} ~/go/bin/
