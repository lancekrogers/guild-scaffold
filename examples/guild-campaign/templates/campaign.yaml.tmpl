# Campaign Configuration
# Generated by guild-scaffold

name: {{ .vars.campaign_name }}
version: "1.0.0"
description: {{ .vars.description | default "A Guild AI agent campaign" | quote }}
{{- if .vars.author }}
author: {{ .vars.author | quote }}
{{- end }}

# Default provider configuration
providers:
  {{ .vars.provider | default "anthropic" }}:
    api_key_env: {{ if eq (.vars.provider | default "anthropic") "anthropic" }}ANTHROPIC_API_KEY{{ else if eq .vars.provider "openai" }}OPENAI_API_KEY{{ else }}OLLAMA_HOST{{ end }}
    default_model: {{ .vars.model | default "claude-3-sonnet-20240229" | quote }}

# Guild definitions
guilds:
  - name: {{ .vars.guild_name | default .vars.campaign_name }}-guild
    config: guilds/{{ .vars.guild_name | default .vars.campaign_name }}-guild.yaml

# Daemon settings
daemon:
  enabled: true
  auto_start: false
  health_check_interval: 30s

# Archive settings
archives:
  enabled: true
  path: archives/
  retention_days: 90
