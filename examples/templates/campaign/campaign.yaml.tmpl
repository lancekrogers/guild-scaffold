# Campaign Configuration
# Generated by guild-scaffold
#
# This file defines your campaign workspace settings including:
# - Provider configuration for AI agents
# - Guild team definitions
# - Daemon and archive settings

name: {{ .vars.campaign_name }}
version: "1.0.0"
description: {{ .vars.description | default "A Guild AI agent campaign" | quote }}
{{- if .vars.author }}
author: {{ .vars.author | quote }}
{{- end }}

# Provider Configuration
# Supports: anthropic, openai, ollama, deepseek
providers:
  {{ .vars.provider | default "anthropic" }}:
    api_key_env: {{ if eq (.vars.provider | default "anthropic") "anthropic" }}ANTHROPIC_API_KEY{{ else if eq .vars.provider "openai" }}OPENAI_API_KEY{{ else if eq .vars.provider "deepseek" }}DEEPSEEK_API_KEY{{ else }}OLLAMA_HOST{{ end }}
    default_model: {{ .vars.model | default "claude-3-sonnet-20240229" | quote }}

# Guild Definitions
# Each guild is a team of agents working together on commissions
guilds:
  - name: {{ .vars.campaign_name }}-default
    config: guilds/default.yaml
    description: "Default guild with balanced capabilities"

  - name: {{ .vars.campaign_name }}-research
    config: guilds/research.yaml
    description: "Research-focused guild for exploration and discovery"

  - name: {{ .vars.campaign_name }}-development
    config: guilds/development.yaml
    description: "Development-focused guild for implementation"

# Commission Mappings
# Maps guilds to their assigned commissions
commission_mappings: {}

# Daemon Configuration
# Controls the background service that manages agent execution
daemon:
  enabled: true
  auto_start: false
  health_check_interval: 30s
  socket_path: .campaign/daemon.sock

# Archive Settings
# Configures memory and context persistence
archives:
  enabled: true
  path: .campaign/archives/
  retention_days: 90
  compression: true

# Workflow Settings
workflows:
  default: collaborative
  available:
    - collaborative
    - sequential
    - parallel

# Cost Optimization
# Monitors and limits API usage costs
cost_optimization:
  enabled: true
  max_daily_cost: 50
  alert_threshold: 40
  currency: USD
