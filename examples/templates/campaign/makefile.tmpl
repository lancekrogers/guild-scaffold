# {{ .vars.campaign_name }} Campaign Makefile
# Generated by guild-scaffold
#
# Common tasks for managing the campaign

.PHONY: help start stop status work list create clean

# Default target
help:
	@echo "{{ .vars.campaign_name }} Campaign Commands"
	@echo ""
	@echo "Daemon:"
	@echo "  make start      - Start the campaign daemon"
	@echo "  make stop       - Stop the campaign daemon"
	@echo "  make status     - Check daemon and campaign status"
	@echo ""
	@echo "Commissions:"
	@echo "  make list       - List all commissions"
	@echo "  make create     - Create a new commission (interactive)"
	@echo "  make work       - Start working on a commission (interactive)"
	@echo ""
	@echo "Knowledge Base:"
	@echo "  make index      - Rebuild corpus index"
	@echo "  make search Q=  - Search corpus (e.g., make search Q='auth')"
	@echo ""
	@echo "Maintenance:"
	@echo "  make clean      - Clean temporary files"
	@echo "  make archive    - Archive completed commissions"
	@echo "  make backup     - Backup campaign state"
	@echo ""
	@echo "Development:"
	@echo "  make test       - Run project tests"
	@echo "  make lint       - Run linters"
	@echo "  make fmt        - Format code"

# =============================================================================
# Daemon Management
# =============================================================================

start:
	@echo "Starting {{ .vars.campaign_name }} daemon..."
	guild daemon start

stop:
	@echo "Stopping {{ .vars.campaign_name }} daemon..."
	guild daemon stop

restart: stop start

status:
	@echo "Campaign Status"
	@echo "==============="
	guild status
	@echo ""
	@echo "Daemon Status"
	@echo "============="
	guild daemon status

# =============================================================================
# Commission Management
# =============================================================================

list:
	@guild commission list

create:
	@read -p "Commission name: " name; \
	read -p "Description: " desc; \
	guild commission create "$$name" --description "$$desc"

work:
	@read -p "Commission to work on: " name; \
	guild work "$$name"

# =============================================================================
# Knowledge Base
# =============================================================================

index:
	@echo "Rebuilding corpus index..."
	guild corpus rebuild

search:
ifndef Q
	@echo "Usage: make search Q='search query'"
else
	guild corpus search "$(Q)"
endif

# =============================================================================
# Kanban
# =============================================================================

kanban:
	guild kanban list

todo:
	guild kanban list --column todo

in-progress:
	guild kanban list --column in-progress

review:
	guild kanban list --column review

# =============================================================================
# Maintenance
# =============================================================================

clean:
	@echo "Cleaning temporary files..."
	rm -f .campaign/daemon.pid
	rm -f .campaign/daemon.log
	find . -name "*.tmp" -delete
	find . -name ".DS_Store" -delete
	@echo "Done."

archive:
	@echo "Archiving completed commissions..."
	guild commission archive --completed
	@echo "Done."

backup:
	@echo "Creating backup..."
	@timestamp=$$(date +%Y%m%d_%H%M%S); \
	tar -czf "../{{ .vars.campaign_name }}_backup_$$timestamp.tar.gz" \
		--exclude='.campaign/daemon.sock' \
		--exclude='.campaign/memory.db-*' \
		--exclude='corpus/embeddings/*' \
		.
	@echo "Backup created in parent directory."

# =============================================================================
# Development (if project code exists)
# =============================================================================

test:
	@if [ -f go.mod ]; then \
		go test ./...; \
	elif [ -f package.json ]; then \
		npm test; \
	elif [ -f requirements.txt ]; then \
		pytest; \
	else \
		echo "No recognized project type found"; \
	fi

lint:
	@if [ -f go.mod ]; then \
		go vet ./...; \
	elif [ -f package.json ]; then \
		npm run lint; \
	elif [ -f requirements.txt ]; then \
		ruff check .; \
	else \
		echo "No recognized project type found"; \
	fi

fmt:
	@if [ -f go.mod ]; then \
		go fmt ./...; \
	elif [ -f package.json ]; then \
		npm run format; \
	elif [ -f requirements.txt ]; then \
		ruff format .; \
	else \
		echo "No recognized project type found"; \
	fi

# =============================================================================
# Environment
# =============================================================================

env:
	@echo "Environment Variables"
	@echo "====================="
	@echo "ANTHROPIC_API_KEY: $${ANTHROPIC_API_KEY:+[SET]}"
	@echo "OPENAI_API_KEY: $${OPENAI_API_KEY:+[SET]}"
	@echo "DEEPSEEK_API_KEY: $${DEEPSEEK_API_KEY:+[SET]}"
	@echo "OLLAMA_HOST: $${OLLAMA_HOST:-http://localhost:11434}"
	@echo ""
	@echo "Campaign: {{ .vars.campaign_name }}"
	@echo "Provider: {{ .vars.provider | default "anthropic" }}"
	@echo "Model: {{ .vars.model | default "claude-3-sonnet-20240229" }}"
