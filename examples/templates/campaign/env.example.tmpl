# Guild Campaign Environment Variables
# Generated by guild-scaffold
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control!

# =============================================================================
# AI Provider API Keys
# =============================================================================

# Anthropic (Claude models)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Ollama (local models)
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# =============================================================================
# Campaign Settings
# =============================================================================

# Campaign name (defaults to directory name)
GUILD_CAMPAIGN_NAME={{ .vars.campaign_name }}

# Default provider (anthropic, openai, ollama, deepseek)
GUILD_DEFAULT_PROVIDER={{ .vars.provider | default "anthropic" }}

# Default model
GUILD_DEFAULT_MODEL={{ .vars.model | default "claude-3-sonnet-20240229" }}

# =============================================================================
# Daemon Settings
# =============================================================================

# Enable daemon auto-start
GUILD_DAEMON_AUTOSTART=false

# Daemon socket path (relative to campaign root)
GUILD_DAEMON_SOCKET=.campaign/daemon.sock

# Health check interval
GUILD_HEALTH_CHECK_INTERVAL=30s

# =============================================================================
# Logging
# =============================================================================

# Log level: debug, info, warn, error
GUILD_LOG_LEVEL=info

# Log format: json, text
GUILD_LOG_FORMAT=text

# =============================================================================
# Cost Controls
# =============================================================================

# Maximum daily cost (USD)
GUILD_MAX_DAILY_COST=50

# Alert threshold (USD)
GUILD_COST_ALERT_THRESHOLD=40

# =============================================================================
# Advanced Settings
# =============================================================================

# Context window for agents (tokens)
# GUILD_CONTEXT_WINDOW=200000

# Archive retention (days)
# GUILD_ARCHIVE_RETENTION=90

# Enable experimental features
# GUILD_EXPERIMENTAL=false
