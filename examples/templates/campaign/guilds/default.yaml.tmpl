# Default Guild Configuration
# Generated by guild-scaffold
#
# A balanced guild with all agent types for general-purpose work.
# This guild can handle a wide variety of commissions.

guild:
  name: {{ .vars.campaign_name }}-default
  version: "1.0.0"
  description: "Default guild with balanced capabilities for general-purpose work"
  created_at: {{ now | date "2006-01-02T15:04:05Z07:00" }}

# Manager Configuration
# The Guild Master orchestrates work and delegates to agents
manager:
  default: guild-master
  fallback:
    - architect
  settings:
    decision_threshold: high
    review_required: true
    max_delegation_depth: 3

# Agent Roster
# List of agent IDs available to this guild
agents:
  - guild-master
  - developer
  - architect
  - tester
  - researcher

# Workflow Configuration
workflows:
  available:
    - collaborative
    - sequential
    - parallel
  default: collaborative
  settings:
    max_concurrent_agents: 3
    timeout_minutes: 60
    checkpoint_interval: 10

# Cost Optimization
cost_optimization:
  enabled: true
  max_cost_per_commission: 25
  prefer_cost_efficient: true
  model_fallback:
    - claude-3-haiku-20240307
    - gpt-3.5-turbo

# Quality Gates
quality:
  code_review_required: true
  test_coverage_minimum: 80
  documentation_required: true

# Metadata
metadata:
  author: {{ .vars.author | default "Guild Framework" | quote }}
  tags:
    - general-purpose
    - balanced
    - default
