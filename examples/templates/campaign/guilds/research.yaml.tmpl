# Research Guild Configuration
# Generated by guild-scaffold
#
# A specialized guild focused on exploration, discovery, and analysis.
# Best suited for investigation, documentation, and research tasks.

guild:
  name: {{ .vars.campaign_name }}-research
  version: "1.0.0"
  description: "Research-focused guild for exploration and discovery"
  created_at: {{ now | date "2006-01-02T15:04:05Z07:00" }}

# Manager Configuration
# The researcher leads this guild with architect support
manager:
  default: researcher
  fallback:
    - architect
    - guild-master
  settings:
    decision_threshold: medium
    review_required: false
    max_delegation_depth: 2

# Agent Roster
# Research-focused agent composition
agents:
  - researcher
  - architect
  - guild-master

# Workflow Configuration
workflows:
  available:
    - sequential
    - collaborative
  default: sequential
  settings:
    max_concurrent_agents: 2
    timeout_minutes: 120
    checkpoint_interval: 15

# Cost Optimization
# Research benefits from more capable models
cost_optimization:
  enabled: true
  max_cost_per_commission: 50
  prefer_cost_efficient: false
  model_preference:
    - claude-3-opus-20240229
    - claude-3-sonnet-20240229
    - gpt-4-turbo

# Quality Gates
quality:
  code_review_required: false
  documentation_required: true
  source_citations_required: true

# Research-Specific Settings
research:
  max_search_depth: 5
  source_verification: true
  summarization_enabled: true
  knowledge_graph_enabled: false

# Metadata
metadata:
  author: {{ .vars.author | default "Guild Framework" | quote }}
  tags:
    - research
    - exploration
    - analysis
    - documentation
