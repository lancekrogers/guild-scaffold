# Development Guild Configuration
# Generated by guild-scaffold
#
# A specialized guild focused on code implementation and testing.
# Best suited for building features, fixing bugs, and writing tests.

guild:
  name: {{ .vars.campaign_name }}-development
  version: "1.0.0"
  description: "Development-focused guild for implementation and testing"
  created_at: {{ now | date "2006-01-02T15:04:05Z07:00" }}

# Manager Configuration
# The architect leads development with developer support
manager:
  default: architect
  fallback:
    - developer
    - guild-master
  settings:
    decision_threshold: high
    review_required: true
    max_delegation_depth: 2

# Agent Roster
# Development-focused agent composition
agents:
  - architect
  - developer
  - tester
  - guild-master

# Workflow Configuration
workflows:
  available:
    - collaborative
    - parallel
    - sequential
  default: collaborative
  settings:
    max_concurrent_agents: 3
    timeout_minutes: 90
    checkpoint_interval: 5

# Cost Optimization
# Development uses balanced cost strategy
cost_optimization:
  enabled: true
  max_cost_per_commission: 35
  prefer_cost_efficient: true
  model_preference:
    - claude-3-sonnet-20240229
    - gpt-4-turbo
    - claude-3-haiku-20240307

# Quality Gates
# Strict quality requirements for code
quality:
  code_review_required: true
  test_coverage_minimum: 90
  documentation_required: true
  lint_required: true
  security_scan_required: true

# Development-Specific Settings
development:
  auto_format: true
  auto_lint: true
  test_on_commit: true
  branch_strategy: feature-branch
  commit_style: conventional

# Tool Access
# Development agents have broader tool access
tools:
  allowed:
    - file
    - git
    - shell
    - test_runner
    - linter
    - formatter
  blocked:
    - dangerous_shell

# Metadata
metadata:
  author: {{ .vars.author | default "Guild Framework" | quote }}
  tags:
    - development
    - implementation
    - testing
    - code
