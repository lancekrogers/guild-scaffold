# fish completion for {{.vars.name}}

complete -c {{.vars.name}} -f

# Commands
complete -c {{.vars.name}} -n '__fish_use_subcommand' -a init -d 'Initialize a new project'
complete -c {{.vars.name}} -n '__fish_use_subcommand' -a run -d 'Run a target'
complete -c {{.vars.name}} -n '__fish_use_subcommand' -a list -d 'List available targets'
complete -c {{.vars.name}} -n '__fish_use_subcommand' -a config -d 'Manage configuration'
complete -c {{.vars.name}} -n '__fish_use_subcommand' -a version -d 'Print version information'
complete -c {{.vars.name}} -n '__fish_use_subcommand' -a help -d 'Help about any command'

# Global flags
complete -c {{.vars.name}} -s h -l help -d 'Show help'
complete -c {{.vars.name}} -s v -l verbose -d 'Enable verbose output'
complete -c {{.vars.name}} -l config -d 'Config file' -r
complete -c {{.vars.name}} -s o -l output -d 'Output format' -xa 'json table yaml'

# run subcommand
complete -c {{.vars.name}} -n '__fish_seen_subcommand_from run' -l dry-run -d 'Show what would be done'
complete -c {{.vars.name}} -n '__fish_seen_subcommand_from run' -s p -l parallel -d 'Parallel jobs' -r

# config subcommand
complete -c {{.vars.name}} -n '__fish_seen_subcommand_from config' -a show -d 'Show configuration'
complete -c {{.vars.name}} -n '__fish_seen_subcommand_from config' -a set -d 'Set a value'
