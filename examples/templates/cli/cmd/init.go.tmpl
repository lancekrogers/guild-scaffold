package cmd

import (
	"fmt"
	"os"
	"path/filepath"

	"github.com/spf13/cobra"
)

var initCmd = &cobra.Command{
	Use:   "init",
	Short: "Initialize a new project",
	Long:  `Initialize a new {{.vars.name}} project in the current directory.`,
	RunE: func(cmd *cobra.Command, args []string) error {
		force, _ := cmd.Flags().GetBool("force")

		configPath := ".{{.vars.name}}.yaml"
		if _, err := os.Stat(configPath); err == nil && !force {
			return fmt.Errorf("config file already exists, use --force to overwrite")
		}

		content := `# {{.vars.name}} configuration
# Generated by {{.vars.name}} init

# Example settings
debug: false
output: table
`
		if err := os.WriteFile(configPath, []byte(content), 0644); err != nil {
			return fmt.Errorf("failed to write config: %w", err)
		}

		fmt.Printf("Initialized {{.vars.name}} in %s\n", filepath.Dir(configPath))
		return nil
	},
}

func init() {
	rootCmd.AddCommand(initCmd)
	initCmd.Flags().Bool("force", false, "overwrite existing config")
}
