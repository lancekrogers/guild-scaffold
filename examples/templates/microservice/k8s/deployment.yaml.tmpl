apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .vars.service_name | lower }}
  labels:
    app: {{ .vars.service_name | lower }}
spec:
  replicas: {{ .vars.replicas | default "3" }}
  selector:
    matchLabels:
      app: {{ .vars.service_name | lower }}
  template:
    metadata:
      labels:
        app: {{ .vars.service_name | lower }}
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8080"
        prometheus.io/path: "/metrics"
    spec:
      containers:
        - name: {{ .vars.service_name | lower }}
          image: {{ .vars.image_registry | default "registry.example.com" }}/{{ .vars.service_name | lower }}:{{ .vars.image_tag | default "latest" }}
          ports:
            - containerPort: 8080
              name: http
            - containerPort: 9090
              name: grpc
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ .vars.service_name | lower }}-secrets
                  key: database-url
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ .vars.service_name | lower }}-secrets
                  key: jwt-secret
          envFrom:
            - configMapRef:
                name: {{ .vars.service_name | lower }}-config
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 5
