apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .vars.service_name | lower }}
  annotations:
    kubernetes.io/ingress.class: nginx
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  tls:
    - hosts:
        - {{ .vars.service_name | lower }}.{{ .vars.domain | default "example.com" }}
      secretName: {{ .vars.service_name | lower }}-tls
  rules:
    - host: {{ .vars.service_name | lower }}.{{ .vars.domain | default "example.com" }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ .vars.service_name | lower }}
                port:
                  number: 80
