apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .vars.service_name | lower }}-config
data:
  SERVER_PORT: "8080"
  LOG_LEVEL: "info"
  CACHE_ENABLED: "true"
  CACHE_HOST: "redis"
  CACHE_PORT: "6379"
  METRICS_ENABLED: "true"
  TRACING_ENABLED: "true"
  TRACING_ENDPOINT: "http://jaeger-collector:14268/api/traces"
