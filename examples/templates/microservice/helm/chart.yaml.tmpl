apiVersion: v2
name: {{ .vars.service_name | lower }}
description: Helm chart for {{ .vars.service_name }}
type: application
version: 0.1.0
appVersion: "1.0.0"

maintainers:
  - name: {{ .vars.author | default "Platform Team" }}

dependencies:
  - name: postgresql
    version: "12.x.x"
    repository: https://charts.bitnami.com/bitnami
    condition: postgresql.enabled
  - name: redis
    version: "17.x.x"
    repository: https://charts.bitnami.com/bitnami
    condition: redis.enabled
