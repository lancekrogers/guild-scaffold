# {{ .vars.service_name }} Environment Configuration

# Server
SERVER_PORT=8080
GRPC_PORT=9090

# Database
DATABASE_URL=postgres://user:password@localhost:5432/{{ .vars.service_name | lower }}?sslmode=disable

# Cache
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Messaging
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP={{ .vars.service_name | lower }}-group
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
