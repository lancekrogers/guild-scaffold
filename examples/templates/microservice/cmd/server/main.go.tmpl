// {{ .vars.service_name }} Server
package main

import (
	"context"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{ .vars.module_path }}/internal/application/handlers"
	"{{ .vars.module_path }}/internal/application/middleware"
	"{{ .vars.module_path }}/internal/infrastructure/database/postgres"
	"{{ .vars.module_path }}/observability"
)

func main() {
	// Initialize logger
	logger := observability.NewLogger()
	logger.Info("Starting {{ .vars.service_name }} server...")

	// Load configuration
	cfg, err := LoadConfig()
	if err != nil {
		logger.Fatal("Failed to load config", "error", err)
	}

	// Initialize database
	db, err := postgres.NewConnection(cfg.DatabaseURL)
	if err != nil {
		logger.Fatal("Failed to connect to database", "error", err)
	}
	defer db.Close()

	// Initialize metrics
	metrics := observability.NewPrometheus()

	// Setup HTTP server
	mux := http.NewServeMux()

	// Apply middleware
	handler := middleware.Chain(
		mux,
		middleware.Logger(logger),
		middleware.CORS(),
		middleware.RateLimit(cfg.RateLimit),
		middleware.Auth(cfg.JWTSecret),
	)

	// Register handlers
	handlers.RegisterHealthHandler(mux)
	handlers.RegisterAPIHandler(mux, db, logger)

	// Create server
	server := &http.Server{
		Addr:         fmt.Sprintf(":%d", cfg.Port),
		Handler:      handler,
		ReadTimeout:  15 * time.Second,
		WriteTimeout: 15 * time.Second,
		IdleTimeout:  60 * time.Second,
	}

	// Graceful shutdown
	done := make(chan os.Signal, 1)
	signal.Notify(done, os.Interrupt, syscall.SIGINT, syscall.SIGTERM)

	go func() {
		logger.Info("Server listening", "port", cfg.Port)
		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			logger.Fatal("Server failed", "error", err)
		}
	}()

	<-done
	logger.Info("Shutting down server...")

	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := server.Shutdown(ctx); err != nil {
		logger.Error("Server shutdown failed", "error", err)
	}

	logger.Info("Server stopped")
}
