#!/bin/bash
# Build all services for {{ .vars.project_name }}
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="${ROOT_DIR}/dist"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Services to build
SERVICES=(
    "auth-service"
    "user-service"
    "order-service"
    "payment-service"
)

# Parse arguments
VERSION="${VERSION:-$(git describe --tags --always --dirty 2>/dev/null || echo 'dev')}"
GOOS="${GOOS:-linux}"
GOARCH="${GOARCH:-amd64}"
PARALLEL="${PARALLEL:-4}"

echo -e "${GREEN}Building {{ .vars.project_name }} services${NC}"
echo "Version: ${VERSION}"
echo "Target: ${GOOS}/${GOARCH}"
echo ""

# Create build directory
mkdir -p "${BUILD_DIR}"

# Build function
build_service() {
    local service=$1
    local service_dir="${ROOT_DIR}/services/${service}"
    local output="${BUILD_DIR}/${service}"

    if [[ ! -d "$service_dir" ]]; then
        echo -e "${YELLOW}Skipping ${service}: directory not found${NC}"
        return 0
    fi

    echo -e "Building ${service}..."

    cd "$service_dir"
    CGO_ENABLED=0 GOOS="${GOOS}" GOARCH="${GOARCH}" go build \
        -ldflags="-w -s -X main.Version=${VERSION}" \
        -o "${output}" \
        ./cmd

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}✓ ${service} built successfully${NC}"
    else
        echo -e "${RED}✗ ${service} build failed${NC}"
        return 1
    fi
}

# Export functions for parallel execution
export -f build_service
export ROOT_DIR BUILD_DIR VERSION GOOS GOARCH
export RED GREEN YELLOW NC

# Build services in parallel
echo "Building services (parallelism: ${PARALLEL})..."
printf '%s\n' "${SERVICES[@]}" | xargs -P "${PARALLEL}" -I {} bash -c 'build_service "{}"'

# Build tools
echo ""
echo "Building tools..."
for tool in migrator seeder cli; do
    tool_dir="${ROOT_DIR}/tools/${tool}"
    if [[ -d "$tool_dir" ]]; then
        echo "Building ${tool}..."
        cd "$tool_dir"
        CGO_ENABLED=0 GOOS="${GOOS}" GOARCH="${GOARCH}" go build \
            -ldflags="-w -s -X main.Version=${VERSION}" \
            -o "${BUILD_DIR}/${tool}" \
            .
        echo -e "${GREEN}✓ ${tool} built${NC}"
    fi
done

echo ""
echo -e "${GREEN}Build complete!${NC}"
echo "Binaries are in: ${BUILD_DIR}"
ls -la "${BUILD_DIR}"
