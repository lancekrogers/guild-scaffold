#!/bin/bash
# Development environment setup for {{ .vars.project_name }}
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}Setting up {{ .vars.project_name }} development environment${NC}"
echo ""

# Check prerequisites
check_command() {
    if ! command -v "$1" &> /dev/null; then
        echo -e "${RED}✗ $1 is not installed${NC}"
        return 1
    else
        echo -e "${GREEN}✓ $1 is installed${NC}"
        return 0
    fi
}

echo "Checking prerequisites..."
MISSING=0
check_command go || ((MISSING++))
check_command docker || ((MISSING++))
check_command docker-compose || ((MISSING++))
check_command kubectl || echo -e "${YELLOW}⚠ kubectl not installed (optional)${NC}"
check_command helm || echo -e "${YELLOW}⚠ helm not installed (optional)${NC}"

if [[ $MISSING -gt 0 ]]; then
    echo -e "${RED}Please install missing prerequisites${NC}"
    exit 1
fi

echo ""
echo "Go version: $(go version)"
echo "Docker version: $(docker --version)"
echo ""

# Create .env file if it doesn't exist
if [[ ! -f "${ROOT_DIR}/.env" ]]; then
    echo "Creating .env file from template..."
    cp "${ROOT_DIR}/.env.example" "${ROOT_DIR}/.env"
    echo -e "${GREEN}✓ Created .env file${NC}"
    echo -e "${YELLOW}⚠ Please update .env with your configuration${NC}"
fi

# Start infrastructure services
echo ""
echo "Starting infrastructure services..."
cd "$ROOT_DIR"
docker-compose up -d postgres redis kafka

# Wait for services to be ready
echo "Waiting for services to be ready..."
sleep 5

# Check service health
echo ""
echo "Checking service health..."

check_service() {
    local name=$1
    local host=$2
    local port=$3

    if nc -z "$host" "$port" 2>/dev/null; then
        echo -e "${GREEN}✓ $name is ready${NC}"
        return 0
    else
        echo -e "${RED}✗ $name is not ready${NC}"
        return 1
    fi
}

check_service "PostgreSQL" "localhost" "5432"
check_service "Redis" "localhost" "6379"
check_service "Kafka" "localhost" "9092"

# Install Go dependencies
echo ""
echo "Installing Go dependencies..."
cd "$ROOT_DIR"
go work sync
go mod download

# Run database migrations
echo ""
echo "Running database migrations..."
cd "${ROOT_DIR}/tools/migrator"
go run . -up

# Seed development data
echo ""
read -p "Seed development data? [y/N] " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    cd "${ROOT_DIR}/tools/seeder"
    go run . -seed
fi

echo ""
echo -e "${GREEN}Development environment is ready!${NC}"
echo ""
echo "Quick start commands:"
echo -e "  ${BLUE}make dev${NC}         - Start all services in development mode"
echo -e "  ${BLUE}make test${NC}        - Run all tests"
echo -e "  ${BLUE}make build${NC}       - Build all binaries"
echo ""
echo "Infrastructure:"
echo "  PostgreSQL: localhost:5432"
echo "  Redis:      localhost:6379"
echo "  Kafka:      localhost:9092"
