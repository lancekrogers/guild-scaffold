# {{ .vars.project_name }} Environment Configuration

# Server
ENVIRONMENT=development
LOG_LEVEL=debug

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB={{ .vars.project_name | lower }}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ .vars.project_name | lower }}?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# Service Ports
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Docker Registry
DOCKER_REGISTRY={{ .vars.registry | default "registry.example.com" }}
