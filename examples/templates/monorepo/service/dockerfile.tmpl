# Build stage
FROM golang:{{ .vars.go_version | default "1.22" }}-alpine AS builder

WORKDIR /build

# Install dependencies
RUN apk add --no-cache git ca-certificates

# Copy go.work and module files
COPY go.work go.work.sum ./
COPY services/{{ .vars.service_name | lower }}/go.mod services/{{ .vars.service_name | lower }}/go.sum ./services/{{ .vars.service_name | lower }}/
COPY libs/ ./libs/

# Download dependencies
RUN cd services/{{ .vars.service_name | lower }} && go mod download

# Copy service source
COPY services/{{ .vars.service_name | lower }}/ ./services/{{ .vars.service_name | lower }}/

# Build binary
RUN cd services/{{ .vars.service_name | lower }} && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s -X main.Version=${VERSION:-dev}" \
    -o /app/server ./cmd

# Runtime stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/server .

# Create non-root user
RUN adduser -D -g '' appuser
USER appuser

# Expose port
EXPOSE {{ .vars.port | default "8080" }}

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:{{ .vars.port | default "8080" }}/health || exit 1

ENTRYPOINT ["./server"]
