# {{ .vars.project_name }} Makefile

.PHONY: all build test lint clean dev docker-build docker-push deploy help

VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
BUILD_DIR := dist

# Services
SERVICES := auth-service user-service order-service payment-service

# Default target
all: build

## Development
dev: ## Run all services in development mode
	@echo "Starting development environment..."
	@docker-compose up -d postgres redis kafka
	@go run ./tools/migrator -up
	@echo "Starting services..."
	@for service in $(SERVICES); do \
		(cd services/$$service && go run ./cmd &); \
	done
	@wait

## Build
build: ## Build all services
	@echo "Building services..."
	@./scripts/build-all.sh

build-service: ## Build a specific service (SERVICE=auth-service)
	@echo "Building $(SERVICE)..."
	@cd services/$(SERVICE) && go build -ldflags="-X main.Version=$(VERSION)" -o ../../$(BUILD_DIR)/$(SERVICE) ./cmd

## Test
test: ## Run all tests
	@./scripts/test-all.sh

test-coverage: ## Run tests with coverage
	@./scripts/test-all.sh --coverage

test-integration: ## Run integration tests
	@./scripts/test-all.sh --integration

test-service: ## Test a specific service (SERVICE=auth-service)
	@cd services/$(SERVICE) && go test -v -race ./...

## Lint
lint: ## Run linter
	@golangci-lint run ./...

fmt: ## Format code
	@gofmt -s -w .

## Database
migrate-up: ## Run database migrations
	@go run ./tools/migrator -up

migrate-down: ## Rollback last migration
	@go run ./tools/migrator -down

migrate-create: ## Create new migration (NAME=create_users)
	@go run ./tools/migrator -create $(NAME)

seed: ## Seed development data
	@go run ./tools/seeder -seed

## Docker
docker-build: ## Build Docker images for all services
	@for service in $(SERVICES); do \
		docker build -f services/$$service/Dockerfile -t {{ .vars.registry | default "registry.example.com" }}/$$service:$(VERSION) .; \
	done

docker-push: docker-build ## Push Docker images
	@for service in $(SERVICES); do \
		docker push {{ .vars.registry | default "registry.example.com" }}/$$service:$(VERSION); \
	done

docker-up: ## Start all containers
	@docker-compose up -d

docker-down: ## Stop all containers
	@docker-compose down

docker-logs: ## View container logs
	@docker-compose logs -f

## Deploy
deploy-staging: ## Deploy to staging
	@./scripts/deploy.sh --env staging --version $(VERSION)

deploy-production: ## Deploy to production
	@./scripts/deploy.sh --env production --version $(VERSION)

## Infrastructure
tf-init: ## Initialize Terraform
	@cd infrastructure/terraform && terraform init

tf-plan: ## Plan Terraform changes
	@cd infrastructure/terraform && terraform plan

tf-apply: ## Apply Terraform changes
	@cd infrastructure/terraform && terraform apply

## Clean
clean: ## Clean build artifacts
	@rm -rf $(BUILD_DIR)
	@rm -f coverage*.out coverage.html
	@find . -name "*.test" -delete

## Help
help: ## Show this help
	@echo "{{ .vars.project_name }} - Available commands:"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'
