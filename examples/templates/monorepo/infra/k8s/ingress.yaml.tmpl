# Kubernetes Ingress for {{ .vars.project_name }}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .vars.project_name | lower }}-ingress
  namespace: {{ .vars.project_name | lower }}
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "10m"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "60"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "60"
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  tls:
    - hosts:
        - api.{{ .vars.domain | default "example.com" }}
        - auth.{{ .vars.domain | default "example.com" }}
      secretName: {{ .vars.project_name | lower }}-tls
  rules:
    - host: api.{{ .vars.domain | default "example.com" }}
      http:
        paths:
          - path: /users
            pathType: Prefix
            backend:
              service:
                name: user-service
                port:
                  number: 80
          - path: /orders
            pathType: Prefix
            backend:
              service:
                name: order-service
                port:
                  number: 80
          - path: /payments
            pathType: Prefix
            backend:
              service:
                name: payment-service
                port:
                  number: 80
    - host: auth.{{ .vars.domain | default "example.com" }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: auth-service
                port:
                  number: 80
