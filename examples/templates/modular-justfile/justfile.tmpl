#!/usr/bin/env just --justfile
# {{ .vars.project_name }} - build and development tasks

set dotenv-load := true

# Configuration
binary_name := "{{ .vars.binary_name | default .vars.project_name }}"
bin_dir := "bin"
gobin := env_var_or_default("GOBIN", `go env GOPATH` + "/bin")

# Modules
[doc('Cross-platform builds')]
mod xbuild '.justfiles/build.just'

[doc('Testing (unit, integration, coverage)')]
mod test '.justfiles/test.just'

[doc('Development workflow')]
mod dev '.justfiles/dev.just'

[private]
default:
    #!/usr/bin/env bash
    echo "{{ .vars.project_name }}"
    echo ""
    just --list --unsorted

# Build binary
build:
    go build -o {{`{{bin_dir}}`}}/{{`{{binary_name}}`}} ./cmd/{{ .vars.binary_name | default .vars.project_name }}

# Build binary only (fast, no vet)
build-only:
    go build -o {{`{{bin_dir}}`}}/{{`{{binary_name}}`}} ./cmd/{{ .vars.binary_name | default .vars.project_name }}

# Format Go code
fmt:
    go fmt ./...

# Run go vet
vet:
    go vet ./...

# Run formatting and vetting
lint: fmt vet
    @echo "Linting complete"

# Clean build artifacts
clean:
    rm -rf {{`{{bin_dir}}`}}

# Update and tidy dependencies
deps:
    go get -u ./...
    go mod tidy

# Install to $GOBIN
install: build
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{`{{gobin}}`}}
    cp {{`{{bin_dir}}`}}/{{`{{binary_name}}`}} {{`{{gobin}}`}}/{{`{{binary_name}}`}}
    if [[ "$(uname)" == "Darwin" ]]; then
        codesign --force --sign - {{`{{gobin}}`}}/{{`{{binary_name}}`}} 2>/dev/null || true
    fi
    echo "Installed to {{`{{gobin}}`}}/{{`{{binary_name}}`}}"

# Uninstall from $GOBIN
uninstall:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f {{`{{gobin}}`}}/{{`{{binary_name}}`}} ]; then
        rm {{`{{gobin}}`}}/{{`{{binary_name}}`}}
        echo "Uninstalled from {{`{{gobin}}`}}"
    else
        echo "Not found in {{`{{gobin}}`}}"
    fi
