# Development recipes for {{ .vars.project_name }}
binary_name := "{{ .vars.project_name }}"
bin_dir := "bin"

[private]
default:
    @just --list --unsorted --justfile {{`{{source_file()}}`}}

# Run the application
[no-cd]
run *args:
    go run ./... {{`{{args}}`}}

# Watch for changes (requires watchexec)
[no-cd]
watch:
    watchexec -e go -r -- just build

# Tidy dependencies
[no-cd]
tidy:
    go mod tidy

# Pre-commit checks
[no-cd]
pre-commit:
    just lint
    just test all
    @echo "Pre-commit checks passed"
