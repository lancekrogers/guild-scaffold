#!/usr/bin/env just --justfile
# {{ .vars.project_name }} - build and development tasks

set dotenv-load := true

# Configuration
binary_name := "{{ .vars.project_name }}"
bin_dir := "bin"

# Modules
[doc('Build commands')]
mod build '.just/build.just'

[doc('Test commands')]
mod test '.just/test.just'

[doc('Development workflow')]
mod dev '.just/dev.just'

[private]
default:
    #!/usr/bin/env sh
    echo "{{ .vars.project_name }}"
    echo ""
    just --list --unsorted

# Quick build
build:
    go build -o {{`{{bin_dir}}`}}/{{`{{binary_name}}`}} ./...

# Format and vet
lint:
    go fmt ./...
    go vet ./...

# Clean artifacts
clean:
    rm -rf {{`{{bin_dir}}`}}
