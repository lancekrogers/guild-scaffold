# Build recipes for {{ .vars.project_name }}

# Build the project
build:
    @echo "Building {{ .vars.project_name }}..."
    go build -v ./...

# Build with race detector
build-race:
    @echo "Building with race detector..."
    go build -race -v ./...

# Clean build artifacts
clean:
    @echo "Cleaning..."
    go clean -cache
    rm -rf bin/
