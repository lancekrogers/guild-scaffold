-- Guild Campaign Database Initialization
-- Campaign: {{ .vars.campaign_name }}
-- Generated by Guild Scaffold v{{ .vars.scaffold_version | default "0.1.0" }}
-- Created: {{ date "2006-01-02 15:04:05" }}

-- Campaign metadata table
CREATE TABLE IF NOT EXISTS campaign_metadata (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    hash TEXT NOT NULL UNIQUE,
    version TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    
    -- Project information
    project_type TEXT,
    project_language TEXT,
    project_framework TEXT,
    project_path TEXT,
    
    -- Configuration JSON
    config TEXT, -- JSON blob for additional config
    
    -- Status tracking
    status TEXT DEFAULT 'active',
    last_activity DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- Agent instances table
CREATE TABLE IF NOT EXISTS agents (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    role TEXT NOT NULL,
    guild_id INTEGER,
    
    -- Configuration
    provider TEXT NOT NULL,
    model TEXT NOT NULL,
    config TEXT, -- JSON configuration
    
    -- Status
    status TEXT DEFAULT 'active',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    last_active DATETIME,
    
    -- Performance tracking
    total_interactions INTEGER DEFAULT 0,
    total_tokens INTEGER DEFAULT 0,
    average_response_time REAL DEFAULT 0.0,
    
    UNIQUE(name)
);

-- Guild teams table
CREATE TABLE IF NOT EXISTS guilds (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    description TEXT,
    
    -- Configuration
    workflow_type TEXT DEFAULT 'collaborative',
    max_members INTEGER DEFAULT 10,
    config TEXT, -- JSON configuration
    
    -- Status
    status TEXT DEFAULT 'active',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- Conversation history
CREATE TABLE IF NOT EXISTS conversations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL,
    agent_id INTEGER,
    guild_id INTEGER,
    
    -- Message content
    role TEXT NOT NULL, -- 'user', 'assistant', 'system'
    content TEXT NOT NULL,
    content_type TEXT DEFAULT 'text',
    
    -- Metadata
    tokens INTEGER DEFAULT 0,
    model TEXT,
    provider TEXT,
    response_time REAL,
    
    -- Timing
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    
    -- Relations
    FOREIGN KEY (agent_id) REFERENCES agents(id),
    FOREIGN KEY (guild_id) REFERENCES guilds(id)
);

-- Task and workflow tracking
CREATE TABLE IF NOT EXISTS tasks (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    
    -- Assignment
    assigned_agent_id INTEGER,
    assigned_guild_id INTEGER,
    
    -- Status
    status TEXT DEFAULT 'pending', -- pending, in_progress, completed, failed
    priority TEXT DEFAULT 'normal', -- low, normal, high, urgent
    
    -- Timing
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    started_at DATETIME,
    completed_at DATETIME,
    due_date DATETIME,
    
    -- Metadata
    metadata TEXT, -- JSON for additional data
    
    FOREIGN KEY (assigned_agent_id) REFERENCES agents(id),
    FOREIGN KEY (assigned_guild_id) REFERENCES guilds(id)
);

-- Performance metrics
CREATE TABLE IF NOT EXISTS metrics (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    metric_name TEXT NOT NULL,
    metric_value REAL NOT NULL,
    metric_unit TEXT,
    
    -- Context
    agent_id INTEGER,
    guild_id INTEGER,
    session_id TEXT,
    
    -- Timing
    recorded_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    
    -- Metadata
    tags TEXT, -- JSON array of tags
    
    FOREIGN KEY (agent_id) REFERENCES agents(id),
    FOREIGN KEY (guild_id) REFERENCES guilds(id)
);

-- Create indexes for performance
CREATE INDEX IF NOT EXISTS idx_conversations_session ON conversations(session_id);
CREATE INDEX IF NOT EXISTS idx_conversations_agent ON conversations(agent_id);
CREATE INDEX IF NOT EXISTS idx_conversations_created ON conversations(created_at);
CREATE INDEX IF NOT EXISTS idx_tasks_status ON tasks(status);
CREATE INDEX IF NOT EXISTS idx_tasks_assigned_agent ON tasks(assigned_agent_id);
CREATE INDEX IF NOT EXISTS idx_metrics_name ON metrics(metric_name);
CREATE INDEX IF NOT EXISTS idx_metrics_recorded ON metrics(recorded_at);

-- Insert initial campaign record
INSERT INTO campaign_metadata (
    name, 
    hash, 
    version,
    project_type,
    project_language,
    project_framework,
    project_path,
    config
) VALUES (
    {{ .vars.campaign_name | quote }},
    {{ .vars.campaign_name | campaignHash | quote }},
    {{ .vars.campaign_version | default "1.0.0" | quote }},
    {{ .computed.project_type | default "generic" | quote }},
    {{- if .computed.project_language }}
    {{ .computed.project_language | quote }},
    {{- else }}
    NULL,
    {{- end }}
    {{- if .computed.project_framework }}
    {{ .computed.project_framework | quote }},
    {{- else }}
    NULL,
    {{- end }}
    {{ .vars.project_path | default "." | quote }},
    {{ .vars | toJSON | quote }}
) ON CONFLICT(name) DO UPDATE SET
    updated_at = CURRENT_TIMESTAMP,
    config = {{ .vars | toJSON | quote }};

-- Create views for common queries
CREATE VIEW IF NOT EXISTS active_agents AS
SELECT 
    a.*,
    g.name as guild_name
FROM agents a
LEFT JOIN guilds g ON a.guild_id = g.id
WHERE a.status = 'active';

CREATE VIEW IF NOT EXISTS recent_conversations AS
SELECT 
    c.*,
    a.name as agent_name,
    g.name as guild_name
FROM conversations c
LEFT JOIN agents a ON c.agent_id = a.id
LEFT JOIN guilds g ON c.guild_id = g.id
WHERE c.created_at > datetime('now', '-24 hours')
ORDER BY c.created_at DESC;

CREATE VIEW IF NOT EXISTS task_summary AS
SELECT 
    status,
    COUNT(*) as count,
    AVG(CASE 
        WHEN completed_at IS NOT NULL THEN 
            (julianday(completed_at) - julianday(started_at)) * 24 * 60 * 60 
        END) as avg_completion_time_seconds
FROM tasks
GROUP BY status;

-- Performance optimization
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
PRAGMA cache_size = 10000;
PRAGMA temp_store = memory;

-- Vacuum and analyze for optimal performance  
VACUUM;
ANALYZE;