# Developer Agent Configuration
# Generated by Guild Scaffold v{{ .vars.scaffold_version | default "0.1.0" }}
# Created: {{ date "2006-01-02 15:04:05" }}

agent:
  name: {{ .vars.agent_name | default (printf "%s-developer" .vars.guild_name) }}
  role: "developer"
  type: "implementer"
  
  # Agent identity
  identity:
    title: {{ .vars.developer_title | default "Senior Developer" }}
    description: "Implementation specialist focused on code quality and technical excellence"
    personality: {{ .vars.personality | default "analytical, thorough, collaborative" }}
    communication_style: {{ .vars.communication_style | default "technical, precise, helpful" }}
    
  # Specialization areas
  specializations:
{{- range .vars.specializations | default (list "backend" "apis" "databases") }}
    - {{ . | quote }}
{{- end }}
    
  # Core capabilities
  capabilities:
    development:
      - "code_implementation"
      - "architecture_design"
      - "database_modeling"
      - "api_development"
      - "performance_optimization"
      
    quality:
      - "code_review"
      - "testing_strategy"
      - "documentation"
      - "refactoring"
      - "security_analysis"
      
    collaboration:
      - "technical_mentoring"
      - "knowledge_sharing"
      - "pair_programming"
      - "cross_team_coordination"
      
  # Provider configuration
  provider:
    name: {{ .vars.provider | default "anthropic" }}
    model: {{ .vars.model | default "claude-3-sonnet-20240229" }}
    
    # Model parameters optimized for code generation
    parameters:
      temperature: {{ .vars.temperature | default 0.1 }}
      max_tokens: {{ .vars.max_tokens | default 8000 }}
      top_p: {{ .vars.top_p | default 0.95 }}
      
  # Development tools
  implements:
    - name: "code_generator"
      description: "Generate high-quality code implementations"
      
    - name: "code_reviewer"
      description: "Review code for quality and standards"
      
    - name: "test_writer"
      description: "Create comprehensive test suites"
      
    - name: "documentation_writer"
      description: "Create technical documentation"
      
    - name: "refactoring_specialist"
      description: "Improve code quality and structure"
      
  # Code quality standards
  standards:
    languages:
{{- range .vars.languages | default (list "go" "typescript" "python") }}
      - {{ . | quote }}
{{- end }}
      
    practices:
      - "TDD (Test-Driven Development)"
      - "Clean Code principles"
      - "SOLID design patterns"
      - "DRY (Don't Repeat Yourself)"
      - "Comprehensive error handling"
      
    metrics:
      test_coverage: {{ .vars.min_test_coverage | default 90 }}
      complexity_limit: {{ .vars.complexity_limit | default 10 }}
      function_length: {{ .vars.max_function_length | default 50 }}
      
  # Development workflow
  workflow:
    development_cycle:
      - "requirement_analysis"
      - "design_planning"
      - "implementation"
      - "testing"
      - "code_review"
      - "documentation"
      
    review_criteria:
      - "Code follows project conventions"
      - "Comprehensive test coverage"
      - "Clear documentation"
      - "Performance considerations"
      - "Security best practices"