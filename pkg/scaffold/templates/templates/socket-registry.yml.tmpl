# Guild Socket Registry
# Manages daemon socket lifecycle for campaign: {{ .vars.campaign_name }}
# Generated by Guild Scaffold v{{ .vars.scaffold_version | default "0.1.0" }}
# Created: {{ date "2006-01-02 15:04:05" }}

registry:
  version: "1.0"
  campaign: {{ .vars.campaign_name | quote }}
  campaign_hash: {{ .vars.campaign_name | campaignHash }}
  
  # Socket Configuration
  socket:
    path: {{ printf "/tmp/guild-%s.sock" (.vars.campaign_name | campaignHash) }}
    permissions: "0600"  # Owner read/write only
    protocol: "unix"
    
  # Process Management
  process:
    pid_file: {{ printf "/tmp/guild-%s.pid" (.vars.campaign_name | campaignHash) }}
    log_file: ".campaign/daemon.log"
    working_directory: {{ .vars.project_path | default "." }}
    
  # Lifecycle Management
  lifecycle:
    auto_start: {{ .vars.daemon_auto_start | default true }}
    auto_restart: {{ .vars.daemon_auto_restart | default true }}
    max_restarts: {{ .vars.max_restarts | default 3 }}
    restart_delay: {{ .vars.restart_delay | default "5s" }}
    
  # Health Checks
  health:
    enabled: {{ .vars.health_checks | default true }}
    interval: {{ .vars.health_interval | default "30s" }}
    timeout: {{ .vars.health_timeout | default "5s" }}
    retries: {{ .vars.health_retries | default 3 }}
    
  # Security
  security:
    allowed_users: 
      - {{ .runtime.user | default "current" }}
    {{- if .vars.allowed_users }}
    {{- range .vars.allowed_users }}
      - {{ . | quote }}
    {{- end }}
    {{- end }}
    
    token_required: {{ .vars.token_required | default false }}
    rate_limit: {{ .vars.rate_limit | default "100/min" }}

# Runtime Information
runtime:
  created_at: {{ dateISO }}
  created_by: {{ .runtime.user | default "guild-scaffold" }}
  environment: {{ .runtime.environment | default "development" }}
  
  # Platform Information
  platform:
    os: {{ .runtime.os | default "unknown" }}
    arch: {{ .runtime.arch | default "unknown" }}
    hostname: {{ .runtime.hostname | default "localhost" }}